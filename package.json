{
  "name": "countersign",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome check --write .",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "decide": "tsx apps/gate/src/decide-main.ts",
    "db:generate": "npm run db:generate --workspace @countersign/db",
    "db:migrate": "tsx --env-file-if-exists=.env.local packages/db/src/migrate-main.ts",
    "ledger": "tsx --env-file-if-exists=.env.local packages/ledger/src/ledger-main.ts",
    "seed": "tsx --env-file-if-exists=.env.local apps/storefront/src/seed-main.ts",
    "propose": "tsx --env-file-if-exists=.env.local apps/gate/src/propose-main.ts",
    "agent": "tsx --env-file-if-exists=.env.local apps/gate/src/agent-main.ts",
    "reconcile": "tsx --env-file-if-exists=.env.local apps/gate/src/reconcile-main.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@paypal/agent-toolkit": "1.11.0"
  }
}
