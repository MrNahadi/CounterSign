# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
# Never paste these values into chat, commits or issues. Sandbox values only.

# --- Safaricom Daraja (sandbox) ---
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
# From your Daraja app (My Apps -> your app)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
# From the portal's sandbox test credentials
DARAJA_C2B_SHORTCODE=
DARAJA_B2C_SHORTCODE=
DARAJA_INITIATOR_NAME=
# The encrypted Security Credential generated from the initiator password, not the password itself
DARAJA_SECURITY_CREDENTIAL=
# Sandbox test phone number, in 2547XXXXXXXX format
DARAJA_TEST_MSISDN=
# Optional, for the STK Push stretch goal
DARAJA_STK_SHORTCODE=
DARAJA_STK_PASSKEY=

# Public HTTPS base that Daraja calls back to (a tunnel now, Render later). Daraja rejects URLs containing
# M-Pesa, Safaricom, exe, exec, cmd, SQL or query in any case, so keep those out of hosts and paths.
CALLBACK_BASE_URL=
# Long random string used as a secret path segment, because Daraja callbacks aren't signed
CALLBACK_PATH_SECRET=

# --- PayPal (sandbox) ---
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Google Gemini ---
# A Gemini Developer API key from Google AI Studio (aistudio.google.com -> Get API key).
# Don't also set GOOGLE_API_KEY: the SDK prefers it over GEMINI_API_KEY.
GEMINI_API_KEY=
