{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [{ "type": "command", "command": "bash scripts/cloud-setup.sh", "timeout": 600 }]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Agent",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git branch --show-current)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm test:*)",
      "Bash(npm run build)",
      "Bash(npm run format)",
      "Bash(npm run db:generate)",
      "Bash(npm run decide:*)",
      "Bash(npm run test:live:*)",
      "Bash(LIVE=1 npm test:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx biome check:*)",
      "Bash(npx tsx --env-file-if-exists=.env.local:*)",
      "Bash(npx playwright:*)",
      "Bash(npx drizzle-kit:*)",
      "Bash(npm install --save-exact:*)",
      "Bash(npm ci:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git fetch:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git push origin:*)",
      "Bash(git push -u origin:*)",
      "Bash(git branch:*)",
      "Bash(git ls-remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(bash scripts/cloud-setup.sh)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(cat .ralph/current-feature)",
      "Bash(cat .ralph/done)",
      "Bash(rm .ralph/done)",
      "Bash(grep:*)",
      "Bash(sed -n:*)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(date:*)"
    ],
    "ask": [
      "Bash(pip install:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(gh:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  }
}
